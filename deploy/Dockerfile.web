# Build admin UI and package with nginx.
# Context: repository parent that contains twstock-radar/

FROM node:22-alpine AS build
WORKDIR /web
COPY twstock-radar/web/package.json twstock-radar/web/package-lock.json ./
RUN npm ci
COPY twstock-radar/web/ ./
# Browser calls same-origin /api (nginx proxies to api:8000)
ENV VITE_API_BASE=/api
RUN npm run build

FROM nginx:1.27-alpine
COPY twstock-radar/deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 80
