DATABASE_URL=postgresql+psycopg://radar:radar@db:5432/radar
# Local fallback:
# DATABASE_URL=sqlite:///./radar.db

API_TOKEN=change-me
TIMEZONE=Asia/Taipei
INGEST_RETRY_TIMES=18:30,19:30,20:30

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack Incoming Webhook
SLACK_WEBHOOK_URL=

# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true

# Rule defaults
TRUST_TOP_K=20
TRUST_STREAK_DAYS=3
TRUST_MIN_NET_LOTS=200
ALERT_COOLDOWN_DAYS=3

# Filters / backfill
EXCLUDE_NON_EQUITY=true
EXCLUDE_CODES=
BACKFILL_SLEEP_SECONDS=1.5

# AI (SpaceXAI / xAI) — keep key server-side only
AI_ENABLED=false
XAI_API_KEY=
AI_MODEL=grok-4.5
AI_MAX_HITS=10
AI_BASE_URL=https://api.x.ai/v1
